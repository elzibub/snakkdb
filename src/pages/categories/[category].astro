---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import SnackCard from "../../components/SnackCard.astro";
import { categoryLabel } from "../../lib/taxonomy";

export async function getStaticPaths() {
  const snacks = await getCollection("snacks");
  const cats = [...new Set(snacks.map((s) => s.data.category))];
  return cats.map((category) => ({
    params: { category },
    props: { category, snacks: snacks.filter((s) => s.data.category === category) },
  }));
}
const { category, snacks } = Astro.props;
---
<Base title={categoryLabel(category)}>
  <h1>{categoryLabel(category)}</h1>
  <ul class="grid">{snacks.map((s) => <SnackCard snack={s} />)}</ul>
</Base>
