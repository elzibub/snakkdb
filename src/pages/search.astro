---
import Base from "../layouts/Base.astro";
import { url } from "../lib/url";
---
<Base title="Search">
  <h1>Search</h1>
  <div id="search"></div>
  <script is:inline src={url("pagefind/pagefind-ui.js")}></script>
  <script is:inline>
    window.addEventListener("DOMContentLoaded", () => {
      new PagefindUI({ element: "#search", showImages: false, autofocus: true });
    });
  </script>
  <noscript>Search needs JavaScript. Browse by <a href="../countries/">country</a> instead.</noscript>
</Base>
