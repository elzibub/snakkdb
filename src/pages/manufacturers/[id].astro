---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import SnackCard from "../../components/SnackCard.astro";
import { loadData, type Manufacturer } from "../../lib/data";
import { flag, countryName } from "../../lib/taxonomy";
import { url } from "../../lib/url";

export async function getStaticPaths() {
  const { makers } = await loadData();
  return [...makers.values()].map((m) => ({ params: { id: m.id }, props: { m } }));
}
const { m } = Astro.props as { m: Manufacturer };
const { snacks, makers } = await loadData();
const d = m.data;
const { Content } = await render(m);
const parent = d.parent && makers.get(d.parent.id);
const subsidiaries = [...makers.values()].filter((x) => x.data.parent?.id === m.id);
const made = snacks.filter((s) => s.data.manufacturer?.id === m.id);
const licensed = snacks.filter((s) => s.data.aliases.some((a) => a.manufacturer?.id === m.id));
---
<Base title={d.name}>
  <h1>{d.name}</h1>
  <p class="muted">
    {d.country && <>{flag(d.country)} {countryName(d.country)}</>}
    {parent && <> · part of <a href={url(`manufacturers/${parent.id}/`)}>{parent.data.name}</a></>}
    {d.website && <> · <a href={d.website}>website</a></>}
  </p>
  <Content />
  {subsidiaries.length > 0 && (
    <p>Brands: {subsidiaries.map((s) => <a class="tag" href={url(`manufacturers/${s.id}/`)}>{s.data.name}</a>)}</p>
  )}
  {made.length > 0 && <><h2>Snacks</h2><ul class="grid">{made.map((s) => <SnackCard snack={s} />)}</ul></>}
  {licensed.length > 0 && <><h2>Makes under another name</h2><ul class="grid">{licensed.map((s) => <SnackCard snack={s} />)}</ul></>}
</Base>
