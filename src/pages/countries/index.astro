---
import Base from "../../layouts/Base.astro";
import { loadData, allCountries } from "../../lib/data";
import { flag, countryName } from "../../lib/taxonomy";
import { url } from "../../lib/url";

const { snacks } = await loadData();
const codes = [...new Set(snacks.flatMap(allCountries))].sort((a, b) => countryName(a).localeCompare(countryName(b)));
const origin = (c: string) => snacks.filter((s) => s.data.origin === c).length;
---
<Base title="Countries">
  <h1>Countries</h1>
  <ul>{codes.map((c) => (
    <li><a href={url(`countries/${c.toLowerCase()}/`)}>{flag(c)} {countryName(c)}</a> <span class="muted">({origin(c)} from here)</span></li>
  ))}</ul>
</Base>
