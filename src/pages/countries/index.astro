---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { flag, countryName } from "../../lib/taxonomy";
import { url } from "../../lib/url";

const counts = new Map<string, number>();
for (const s of await getCollection("snacks"))
  for (const c of s.data.countries) counts.set(c, (counts.get(c) ?? 0) + 1);
const rows = [...counts].sort((a, b) => countryName(a[0]).localeCompare(countryName(b[0])));
---
<Base title="Countries">
  <h1>Countries</h1>
  <ul>{rows.map(([c, n]) => <li><a href={url(`countries/${c.toLowerCase()}/`)}>{flag(c)} {countryName(c)}</a> <span class="muted">({n})</span></li>)}</ul>
</Base>
